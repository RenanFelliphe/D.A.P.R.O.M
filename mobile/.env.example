# Endereço da `api` que o app usa. O emulador Android enxerga a máquina em 10.0.2.2; no aparelho físico, o IP da máquina na rede
# (por exemplo http://192.168.0.10:3333). Em produção, o endereço https da `api`.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3333

# Só no build de desenvolvimento: libera `http://` (a `api` local). O APK de produção não define isto.
APP_PERMITIR_HTTP=true

# Opcional: o endereço da web. O "Me leve lá" da Vitória abre nele o que só existe na web (dashboard, catálogo, equipes).
# EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3000
