{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env --env-file-if-exists=../.env.local src/servidor.ts",
    "dev:local": "tsx src/local.ts",
    "start": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.local src/servidor.ts",
    "test": "node --import tsx --test --test-concurrency=4 \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:test": "node db/tests/schema.mjs && tsx db/tests/carga-inicial.ts",
    "typecheck": "tsc --noEmit",
    "db:gerar-seed": "node src/db/seed/gerar-modelos-apr.mjs",
    "admin:criar": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.local scripts/criar-admin.ts",
    "usuarios:migrar-emails": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.local scripts/migrar-emails.ts",
    "rh:carga-inicial": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.local scripts/carregar-registro-rh.ts",
    "vitoria:conferir-ia": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.local scripts/conferir-vitoria-ia.ts",
    "demo:popular": "tsx --env-file-if-exists=../.env --env-file-if-exists=../.env.local scripts/popular-demo.ts",
    "pdf:exemplo": "tsx scripts/gerar-pdf-os.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.0",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
